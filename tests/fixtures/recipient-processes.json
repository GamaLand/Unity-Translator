{
 "description": "Shared game-process vectors for game_process.classify_game_processes and the recipient core's GameProcessStatus. A synthetic layout holds {root} ('Game Root' with bin), {other} ('Other Install') and {sibling} ('Game Root Two'). Tokens: {root}, {root_upper}, {root_lower}, {root_posix}, {other}, {sibling}, {drive}, {x256}. names null means the executable walk failed. Python and the core always match 'expect'; a row may name an intentional core 'difference' only with the exact 'powershell' result.",
 "differences": {
  "python-casefold": {
   "kind": "intentional",
   "reason": "Python matches executable names with Unicode case folding, which also equates sharp s with SS; the core's OrdinalIgnoreCase does not, like NTFS. It only affects a process with an unreadable image whose name differs from every game EXE on NTFS; Python reports unknown and fails closed."
  },
  "image-is-root-folder": {
   "kind": "intentional",
   "reason": "A process image is a file and can never be the game folder itself. Python counts the folder as under the root; the core ignores the impossible row."
  }
 },
 "cases": [
  {
   "id": "no-processes",
   "expect": "closed",
   "names": [
    "Game.exe",
    "Crash.exe"
   ],
   "snapshot": []
  },
  {
   "id": "game-image-under-root",
   "expect": "running",
   "names": [
    "Game.exe",
    "Crash.exe"
   ],
   "snapshot": [
    {
     "name": "Game.exe",
     "image": "{root}\\Game.exe"
    }
   ]
  },
  {
   "id": "helper-under-root",
   "expect": "running",
   "names": [
    "Game.exe",
    "Crash.exe"
   ],
   "snapshot": [
    {
     "name": "Helper.exe",
     "image": "{root}\\bin\\Helper.exe"
    }
   ],
   "note": "any image under the root counts, named or not"
  },
  {
   "id": "root-case-variant-upper",
   "expect": "running",
   "names": [
    "Game.exe",
    "Crash.exe"
   ],
   "snapshot": [
    {
     "name": "GAME.EXE",
     "image": "{root_upper}\\GAME.EXE"
    }
   ]
  },
  {
